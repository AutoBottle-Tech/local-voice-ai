# ── LiveKit ──────────────────────────────────────────────────────────────
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Agent profile ───────────────────────────────────────────────────────
# Set to "habits" for Habits coach (food + calendar tools via habits-api)
AGENT_PROFILE=default

# Habits integration (when AGENT_PROFILE=habits)
HABITS_API_URL=http://host.docker.internal:8787
HABITS_INTERNAL_BEARER=

# ── LLM ─────────────────────────────────────────────────────────────────
LLM_PROVIDER=llama
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# ── STT / TTS ─────────────────────────────────────────────────────────────
STT_PROVIDER=nemotron
TTS_PROVIDER=kokoro
TTS_BASE_URL=http://127.0.0.1:8880/v1
TTS_VOICE=af_nova

# ── Web UI ──────────────────────────────────────────────────────────────
WEB_PORT=8080
